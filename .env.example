# TikTok
TIKTOK_REGION=br
REQUEST_DELAY_MS=2000
MAX_VIDEOS_PER_HASHTAG=30

# Sessão anônima (automática — sem login)
SESSION_TTL_MS=2700000
SIGNED_URL_TTL_MS=300000
USE_STEALTH=true

# Proxy residencial BR (opcional — só se captcha persistir)
# PROXY_URL=http://user:pass@host:port

# Hashtags padrão (separadas por vírgula, sem #)
DEFAULT_HASHTAGS=achadinhos,produtosvirais,tiktokshop

# Firebase do mestreafili (opcional)
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\PC\Desktop\Afiliadoteste-main\functions\serviceAccountKey.json
FIREBASE_TIKTOK_COLLECTION=tiktok_shop_test

# ScrapeCreators — https://docs.scrapecreators.com/
# Endpoint TikTok Shop pago. 1 crédito por chamada. Cole sua chave aqui.
SCRAPECREATORS_API_KEY=cole_sua_chave_aqui
